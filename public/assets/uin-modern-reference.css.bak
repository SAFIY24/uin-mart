/* UIN MART — Screenshot-inspired theme. Separate namespace, no SVG scaling issues. */



:root{--mart-maroon:#800e19;--mart-dark:#660b14;--mart-gold:#e4a71f;--mart-text:#1c1d22;--mart-border:#e9e9e9}



html{scroll-behavior:smooth}body.mart-body{margin:0;background:#fff;color:var(--mart-text);font-family:Inter,'Segoe UI',Arial,sans-serif;font-size:14px;line-height:1.45}



.mart-body *, .mart-body *::before,.mart-body *::after{box-sizing:border-box}



.mart-body a{text-decoration:none}.mart-body button,.mart-body input{font:inherit}



/* Header */



.mart-body .mart-header{background:linear-gradient(110deg,#780b15 0%,#88111c 56%,#750d17 100%);color:white;width:100%;box-shadow:none}



.mart-body .mart-header-inner{width:100%;max-width:1570px;margin:auto;min-height:95px;padding:12px 46px;display:flex;align-items:center;justify-content:space-between;gap:32px}



.mart-body .mart-brand{display:flex;align-items:center;gap:16px;min-width:340px;color:white;flex-shrink:0}



.mart-body .mart-brand img{width:80px;height:70px;object-fit:contain;flex-shrink:0}



.mart-body .mart-brand-words{display:flex;flex-direction:column;min-width:0}



.mart-body .mart-brand-words strong{display:block;font-size:35px;line-height:1.03;font-weight:850;letter-spacing:-.7px;white-space:nowrap;color:#fff}



.mart-body .mart-brand-words em{color:var(--mart-gold);font-style:normal}



.mart-body .mart-brand-words small{font-size:13px;line-height:1.4;color:#fff;white-space:nowrap;font-weight:600;letter-spacing:.1px}



.mart-body .mart-search{display:flex;align-items:stretch;flex:1 1 650px;max-width:650px;min-width:200px;margin:0;height:48px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 4px #00000015}



.mart-body .mart-search input{flex:1;min-width:0;margin:0;border:0!important;background:#fff!important;color:#222!important;padding:0 17px;font-size:14px;outline:none;box-shadow:none;border-radius:0}



.mart-body .mart-search button{display:grid;place-items:center;width:52px;flex:0 0 52px;border:0;background:var(--mart-gold);color:#fff;cursor:pointer;padding:0}



.mart-body .mart-search button svg{width:25px;height:25px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}



.mart-body .mart-header-right{display:flex;align-items:center;justify-content:flex-end;gap:16px;margin:0;color:white;min-width:265px;flex:0 0 auto}



.mart-body .mart-header-right a,.mart-body .mart-header-right button{color:white;font-size:13px;font-weight:600}



.mart-body .mart-header-right form{margin:0}.mart-body .mart-logout{background:transparent;border:0;cursor:pointer;padding:5px}



.mart-body .mart-greeting{display:flex;gap:8px;align-items:center;white-space:nowrap;font-size:13px;font-weight:600;color:white}



.mart-body .mart-greeting svg{width:28px;height:28px;stroke:white;stroke-width:1.65;fill:none}



.mart-body .mart-cart-header{position:relative;margin-left:8px;display:inline-flex;align-items:center;justify-content:center}


/* ==========================================
   UIN MART - LAYOUT STABILITY FIX
   ========================================== */

html {
    min-height: 100%;
}

body.mart-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
}

/* Header luôn nằm trong luồng trang */
body.mart-body > .mart-header {
    position: relative;
    inset: auto;
    order: 0;
    flex: 0 0 auto;
    width: 100%;
    margin: 0;
    transform: none;
}

/* Nội dung nằm ngay sau header */
body.mart-body > .mart-page {
    position: relative;
    order: 1;
    flex: 1 0 auto;
    width: 100%;
    min-width: 0;
    margin-top: 0;
    transform: none;
}

/* Footer nằm sau nội dung */
body.mart-body > .mart-footer {
    position: relative;
    order: 2;
    flex: 0 0 auto;
    width: 100%;
    margin-top: 0;
    transform: none;
}

