<!-- PROSES PENGIRIMAN -->
<div class="sod-card sod-delivery-card">

    <h2>Proses Pengiriman</h2>

    <p class="sod-delivery-desc">
        Kelola pesanan toko Anda secara bertahap.
        Pembeli akan melakukan konfirmasi setelah
        barang diterima.
    </p>

    <!-- PESAN SUKSES -->
    @if(session('success'))
        <div class="sod-delivery-alert success">
            {{ session('success') }}
        </div>
    @endif

    <!-- PESAN ERROR -->
    @if($errors->any())
        <div class="sod-delivery-alert error">
            @foreach($errors->all() as $error)
                <div>{{ $error }}</div>
            @endforeach
        </div>
    @endif

    @if(!$fulfillment)

        <div class="sod-delivery-alert error">
            Data pengiriman belum tersedia untuk
            pesanan ini. Hubungi Admin untuk
            pemeriksaan pesanan lama.
        </div>

    @else

        @php
            $deliveryLabels = [
                'pending' => 'Menunggu Konfirmasi',
                'confirmed' => 'Dikonfirmasi',
                'preparing' => 'Sedang Dipersiapkan',
                'ready' => 'Siap Dikirim / Diambil',
                'delivering' => 'Dalam Pengiriman',
                'handed_over' => 'Menunggu Konfirmasi Pembeli',
                'completed' => 'Selesai',
                'cancelled' => 'Dibatalkan',
            ];

            $deliverySteps = [
                'pending',
                'confirmed',
                'preparing',
                'ready',
                'handed_over',
                'completed',
            ];

            $currentStep = array_search(
                $fulfillment->status,
                $deliverySteps,
                true
            );

            $actions = [
                'pending' => [
                    'route' => 'seller.orders.confirm',
                    'label' => 'Konfirmasi Pesanan',
                ],
                'confirmed' => [
                    'route' => 'seller.orders.prepare',
                    'label' => 'Siapkan Produk',
                ],
                'preparing' => [
                    'route' => 'seller.orders.ready',
                    'label' => 'Produk Siap Dikirim',
                ],
                'ready' => [
                    'route' => 'seller.orders.handover',
                    'label' => 'Barang Sudah Diserahkan',
                ],
            ];

            $currentAction = $actions[$fulfillment->status] ?? null;
        @endphp

        <div class="sod-info">
            <span>Status Pengiriman</span>

            <div class="sod-delivery-status">
                {{ $deliveryLabels[$fulfillment->status]
                    ?? $fulfillment->status }}
            </div>
        </div>

        <div class="sod-delivery-progress">

            @foreach($deliverySteps as $index => $step)

                @php
                    $stepClass = '';

                    if ($currentStep !== false) {
                        if ($index < $currentStep) {
                            $stepClass = 'done';
                        } elseif ($index === $currentStep) {
                            $stepClass = 'active';
                        }
                    }
                @endphp

                <div class="sod-delivery-step {{ $stepClass }}">
                    {{ $deliveryLabels[$step] }}
                </div>

            @endforeach

        </div>

        @if($order->order_status === 'cancelled')

            <div class="sod-delivery-alert error">
                Pesanan ini telah dibatalkan oleh Admin.
                Proses pengiriman tidak dapat dilanjutkan.
            </div>

        @elseif($order->order_status === 'completed')

            <div class="sod-delivery-alert success">
                Pesanan utama telah ditandai selesai.
                Perubahan pengiriman harus diperiksa
                oleh Admin.
            </div>

        @elseif($fulfillment->status === 'completed')

            <div class="sod-delivery-alert success">
                Pengiriman selesai.
                Barang telah dikonfirmasi diterima
                oleh pembeli.
            </div>

        @elseif($fulfillment->status === 'handed_over')

            <div class="sod-delivery-alert success">
                Barang sudah ditandai diserahkan.
                Menunggu pembeli melakukan konfirmasi
                penerimaan.
            </div>

        @elseif($fulfillment->status === 'cancelled')

            <div class="sod-delivery-alert error">
                Pengiriman ini telah dibatalkan.
            </div>

        @elseif($currentAction)

            <div class="sod-delivery-action">

                <form
                    action="{{ route($currentAction['route'], $order) }}"
                    method="POST"
                >
                    @csrf

                    <button
                        type="submit"
                        class="sod-delivery-submit"
                        onclick="return confirm('Lanjutkan proses pesanan ini?')"
                    >
                        {{ $currentAction['label'] }}
                    </button>
                </form>

            </div>

        @else

            <p class="sod-delivery-desc">
                Tidak ada tindakan Seller yang tersedia
                untuk status pengiriman ini.
            </p>

        @endif

    @endif

</div>


    <!-- KEMBALI -->
    <a
        class="sod-btn"
        href="{{ route('seller.orders.index') }}"
    >
        ← Kembali ke Pesanan Masuk
    </a>

</div>

