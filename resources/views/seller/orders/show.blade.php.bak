        @if($fulfillment->schedule_change_reason)
            <div class="sod-info">
                <span>Permintaan Perubahan Pembeli</span>
                <strong>{{ $fulfillment->schedule_change_reason }}</strong>
            </div>
        @endif

        @if($scheduleEditable)

            <form
                method="POST"
                action="{{ route('seller.orders.schedule.propose', $order) }}"
                style="margin-top:20px;"
            >
                @csrf

                <div style="margin-bottom:15px;">
                    <label
                        for="scheduled_at"
                        style="display:block;margin-bottom:8px;font-weight:700;"
                    >
                        Tanggal dan Jam *
                    </label>

                    <input
                        type="datetime-local"
                        id="scheduled_at"
                        name="scheduled_at"
                        value="{{ old('scheduled_at', $fulfillment->scheduled_at ? \Carbon\Carbon::parse($fulfillment->scheduled_at)->format('Y-m-d\TH:i') : '') }}"
                        required
                        style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #ded6d9;border-radius:9px;"
                    >
                </div>

                <div style="margin-bottom:15px;">
                    <label
                        for="schedule_note"
                        style="display:block;margin-bottom:8px;font-weight:700;"
                    >
                        Catatan untuk Pembeli
                    </label>

                    <textarea
                        id="schedule_note"
                        name="schedule_note"
                        rows="3"
                        maxlength="1000"
                        placeholder="Contoh: Bertemu di depan perpustakaan kampus."
                        style="width:100%;box-sizing:border-box;padding:12px;border:1px solid #ded6d9;border-radius:9px;"
                    >{{ old('schedule_note', $fulfillment->schedule_note) }}</textarea>
                </div>

