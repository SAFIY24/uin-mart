<div class="sod-card">

    <h2>Jadwal Pengiriman / Pengambilan</h2>

    @if(!$fulfillment)

        <p class="sod-note">
            Data pengiriman belum tersedia.
        </p>

    @else

        @php
            $scheduleLabels = [
                'not_proposed' => 'Belum Diajukan',
                'proposed' => 'Menunggu Konfirmasi Pembeli',
                'confirmed' => 'Disetujui Pembeli',
                'change_requested' => 'Pembeli Meminta Perubahan',
            ];

            $scheduleEditable =
                !in_array(
                    $order->order_status,
                    ['cancelled', 'completed'],
                    true
                )
                && in_array(
                    $fulfillment->status,
                    ['pending', 'confirmed', 'preparing', 'ready'],
                    true
                );
        @endphp

        <div class="sod-info">
            <span>Status Jadwal</span>
            <strong>
                {{ $scheduleLabels[$fulfillment->schedule_status]
                    ?? $fulfillment->schedule_status }}
            </strong>
        </div>

        @if($fulfillment->scheduled_at)
            <div class="sod-info">
                <span>Jadwal yang Diajukan</span>
                <strong>
                    {{ \Carbon\Carbon::parse($fulfillment->scheduled_at)->format('d/m/Y H:i') }}
                </strong>
            </div>
        @endif

        @if($fulfillment->schedule_note)
            <div class="sod-info">
                <span>Catatan Penjual</span>
                <strong>{{ $fulfillment->schedule_note }}</strong>
            </div>
